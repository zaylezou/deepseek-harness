{
  "name": "dsh-composer-enter-newline",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Configurable send keys for the composer: set Enter, Shift+Enter, and Ctrl/Cmd+Enter to newline, queue send, or force send.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
